# Copie como .env (no se sube al repositorio) y cargue las variables antes de iniciar el conector.
# Use un usuario de la base con permiso SOLO de lectura (SELECT) sobre la vista de atenciones.
SEAD_PGHOST=127.0.0.1
SEAD_PGPORT=5432
SEAD_PGDATABASE=iess
SEAD_PGUSER=lector_sead
SEAD_PGPASSWORD=cambie-esta-clave
# 1 para exigir TLS verificado hacia el servidor de la base
SEAD_PGSSL=0
# Puerto del conector y direcciones desde las que se abre la app (Live Server usa 5500)
SEAD_PUERTO=8790
SEAD_ORIGENES=http://127.0.0.1:5500,http://localhost:5500
SEAD_MAX_FILAS=200000
