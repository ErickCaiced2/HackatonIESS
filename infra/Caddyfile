# HTTPS local con certificado de la CA interna de Caddy. /api va al backend; el resto, a Next.js
# (por ahora `npm run dev` en este equipo, puerto 3000).
localhost {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy host.docker.internal:3000
	}
}
